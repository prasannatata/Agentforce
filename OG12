            Decimal rev = Decimal.valueOf(o.Revenue_TXT__c);
            data.put(o.Modality__c, data.containsKey(o.Modality__c) ? data.get(o.Modality__c) + rev : rev);
        }
        String out = '**MODALITY PERFORMANCE**\n\n| Modality | Revenue |\n';
        for (String m : data.keySet()) {
            out += '| ' + m + ' | $' + data.get(m) + ' |\n';
        }
        return out;
    }
}
