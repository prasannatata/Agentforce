        </mxCell>
        <mxCell id="ka" value="Provide Knowledge Article&#xa;or Quick Answer" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="180" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="webinar" value="Auto-Suggest Webinars&#xa;(Job 2)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="260" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="decision" value="Need More Help?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="300" y="340" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="job1" value="Job 1: KA Support&#xa;- Detailed guidance&#xa;- Troubleshooting&#xa;- Deep articles" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
