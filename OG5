requests.add(new TestDataQueryAction.QueryRequest('Compare ORD-1008 and ORD-1009'));
requests.add(new TestDataQueryAction.QueryRequest('Show customer revenue analysis'));
requests.add(new TestDataQueryAction.QueryRequest('Show vendor performance comparison'));
requests.add(new TestDataQueryAction.QueryRequest('Show modality performance'));
requests.add(new TestDataQueryAction.QueryRequest('Show orders with status In Progress'));
requests.add(new TestDataQueryAction.QueryRequest('Show orders with status Completed'));

